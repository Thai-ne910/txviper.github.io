 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>900</width><height>700</height></rect>
  </property>
  <property name="windowTitle">
   <string>Ứng Dụng Quản Lý Đặt Đồ Ăn Online</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QMainWindow {
    background-color: #f5f5f5;
}
QLabel#lbl_header {
    color: #2c3e50;
    background-color: #ecf0f1;
    border-radius: 10px;
    padding: 10px;
    border: 1px solid #bdc3c7;
}
QPushButton {
    background-color: #3498db;
    color: white;
    border-radius: 5px;
    padding: 8px;
    font-weight: bold;
}
QPushButton:hover {
    background-color: #2980b9;
}
QPushButton#btn_product { background-color: #2ecc71; }
QPushButton#btn_product:hover { background-color: #27ae60; }
QPushButton#btn_order { background-color: #e74c3c; }
QPushButton#btn_order:hover { background-color: #c0392b; }
QPushButton#btn_order_item { background-color: #9b59b6; }
QPushButton#btn_order_item:hover { background-color: #8e44ad; }
QPushButton#btn_payment { background-color: #f39c12; }
QPushButton#btn_payment:hover { background-color: #d35400; }
QPushButton#btn_product_sales { background-color: #1abc9c; }
QPushButton#btn_product_sales:hover { background-color: #16a085; }
QPushButton#btn_user { background-color: #3498db; }
QPushButton#btn_user:hover { background-color: #2980b9; }

QTableWidget {
    background-color: white;
    alternate-background-color: #ecf0f1;
    selection-background-color: #3498db;
    selection-color: white;
    border-radius: 5px;
    border: 1px solid #bdc3c7;
}
QTableWidget::item { padding: 5px; }
QTableWidget QHeaderView::section {
    background-color: #34495e;
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
}

QStatusBar, QMenuBar, QMenu {
    background-color: #34495e;
    color: white;
}
QMenuBar::item {
    padding: 8px 16px;
}
QMenuBar::item:selected, QMenu::item:selected {
    background-color: #2c3e50;
}
QMenu::item:selected {
    background-color: #3498db;
}
QLabel#lbl_user_info {
    color: #16a085;
    font-weight: bold;
}
   </string>
  </property>
